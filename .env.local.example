# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Gemini
GEMINI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ONE_TIME_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# GoHighLevel (Private Integration token)
GHL_API_KEY=
GHL_LOCATION_ID=
# Shared secret used by GHL Workflow Webhook actions.
# Generate one with: openssl rand -hex 32
# Then in each GHL Workflow → Webhook action, add Custom Header:
#   x-wh-signature: <same-value-as-this-env-var>
GHL_WEBHOOK_SECRET=

# Public site URL — used to render the webhook URL shown in the admin Integrations page
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
